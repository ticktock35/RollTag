    "ai.tag.batch.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag the clicked clip, or every selected video and photo, one by one. Tags are kept immediately."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對這支或目前選取裡可打標的影片與照片，一支一支送 AI，打完就留下，不必確認。"
          }
        }
      }
    },
    "ai.tag.batch.untagged.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag every taggable untagged video and photo in the current folder scope, one by one. Tags are kept immediately."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對目前範圍內所有可打標的未打標影片與照片，一支一支送 AI，打完就留下，不必確認。"
          }
        }
      }
    },
